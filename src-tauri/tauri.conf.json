{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ebook Reader",
  "version": "0.1.0",
  "identifier": "com.ebookreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ebook Reader",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; img-src 'self' data: book: http://book.local https://book.local; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' book: http://book.local https://book.local"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
